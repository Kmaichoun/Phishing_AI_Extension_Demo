# MySQL/MariaDB
# localhost ใช้เมื่อ Backend อยู่บนเซิร์ฟเวอร์เดียวกับฐานข้อมูลเท่านั้น
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ip_std6730202581
MYSQL_USER=your_database_username
MYSQL_PASSWORD=your_database_password
MYSQL_CHARSET=utf8mb4

# ใช้ DATABASE_URL แทนค่าด้านบนได้ แต่ไม่ควร commit รหัสผ่านจริง
# DATABASE_URL=mysql+pymysql://user:password@host:3306/ip_std6730202581?charset=utf8mb4

# Authentication
AUTH_SESSION_HOURS=168
AUTH_COOKIE_SECURE=false
AUTH_WEB_ORIGINS=http://app.phishradar.localhost:5505,http://127.0.0.1:5505,http://localhost:5505
SEARCH_HISTORY_RETENTION_DAYS=90

# Optional LLM
# ค่าเริ่มต้นใช้ Qwen ในเครื่องผ่าน Ollama
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:4b
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# OpenAI เป็นตัวเลือกสำรอง
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-luna
