# Local SQL Server Express (Windows Authentication)
SQL_SERVER=localhost\SQLEXPRESS
SQL_DATABASE=PhishRadarDB
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_TRUSTED_CONNECTION=yes
SQL_ENCRYPT=no
SQL_TRUST_SERVER_CERTIFICATE=yes

# Authentication
AUTH_SESSION_HOURS=168
AUTH_COOKIE_SECURE=false
AUTH_WEB_ORIGINS=http://app.phishradar.localhost:5505,http://127.0.0.1:5505,http://localhost:5505
SEARCH_HISTORY_RETENTION_DAYS=90

# Optional LLM
# ค่าเริ่มต้นใช้ Qwen ในเครื่องผ่าน Ollama
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:4b
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# OpenAI เป็นตัวเลือกสำรอง
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-luna
